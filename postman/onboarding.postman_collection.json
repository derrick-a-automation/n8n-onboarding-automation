{
  "info": {
    "name": "n8n Onboarding Automation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Test requests for the HR-triggered onboarding workflow. Set managerEmail to an inbox you can read (e.g. a +mgr plus-address) so the form-link email reaches you. webhookPrefix is 'webhook' for the active workflow, 'webhook-test' while listening in the editor."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5678"
    },
    {
      "key": "webhookPrefix",
      "value": "webhook"
    },
    {
      "key": "managerEmail",
      "value": "your.inbox+mgr@gmail.com"
    }
  ],
  "item": [
    {
      "name": "1. HR trigger (/newhire)",
      "item": [
        {
          "name": "FTE new hire",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('n8n accepted the request', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Happy path, FTE branch. No onbId: n8n generates one.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mary-Kate\",\n  \"lastName\": \"O'Neil\",\n  \"employmentType\": \"FTE\",\n  \"startDate\": \"2026-11-03\",\n  \"managerEmail\": \"{{managerEmail}}\",\n  \"employeeEmail\": \"mk.oneil@example.com\",\n  \"jobTitle\": \"Network Analyst\",\n  \"department\": \"IT Infrastructure\",\n  \"location\": \"Remote\",\n  \"requestedBy\": \"hr.user@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/{{webhookPrefix}}/newhire",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{webhookPrefix}}",
                "newhire"
              ]
            }
          }
        },
